name: CI

# PR and main use the same impact-aware verification engine.
# Matrix First is the mandatory browser verification barrier for all official test jobs.
on:
  pull_request:
    branches: [main]
  push:
    branches: [main]
  workflow_dispatch:

concurrency:
  group: ci-${{ github.head_ref || github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

permissions:
  contents: read
  checks: read

env:
  NPM_CONFIG_AUDIT: 'false'
  NPM_CONFIG_FUND: 'false'
  NPM_CONFIG_UPDATE_NOTIFIER: 'false'
  VITE_SITE_URL: https://flixoai.vercel.app
  CHANGE_BASE: ${{ github.event_name == 'pull_request' && github.event.pull_request.base.sha || (github.event_name == 'push' && github.event.before) || github.sha }}

jobs:
  matrix-first-barrier:
    name: Matrix First Barrier
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - name: Wait for exact-head Matrix First Certification
        env:
          GH_TOKEN: ${{ github.token }}
          REPOSITORY: ${{ github.repository }}
          HEAD_SHA: ${{ github.event.pull_request.head.sha || github.sha }}
        shell: bash
        run: |
          set -euo pipefail
          echo "Waiting for Matrix First Certification on exact SHA: $HEAD_SHA"
          conclusion="NOT_FOUND"
          for attempt in {1..60}; do
            conclusion=$(gh api "repos/$REPOSITORY/commits/$HEAD_SHA/check-runs?per_page=100" \
              --jq '[.check_runs[] | select(.name=="Matrix First Certification") | select(.head_sha==env.HEAD_SHA)] | sort_by(.completed_at) | last | .conclusion // "NOT_FOUND"')
            case "$conclusion" in
              success) exit 0 ;;
              failure|cancelled|timed_out|action_required|stale) exit 1 ;;
              *) sleep 30 ;;
            esac
          done
          exit 1

  ultra-fast:
    name: Ultra — Fast Triage
    needs: [matrix-first-barrier]
    if: needs.matrix-first-barrier.result == 'success'
    runs-on: ubuntu-latest
    env:
      EXPECTED_SHA: ${{ github.event.pull_request.head.sha || github.sha }}
    steps:
      - uses: actions/checkout@v5
        with:
          ref: ${{ github.event.pull_request.head.sha || github.sha }}
          fetch-depth: 0
      - uses: actions/setup-node@v5
        with:
          node-version-file: .nvmrc
          cache: npm
      - run: npm ci --prefer-offline --no-audit --no-fund
      - name: Run Ultra Fast triage
        id: triage
        continue-on-error: true
        env:
          EXPECTED_SHA: ${{ github.event.pull_request.head.sha || github.sha }}
          CHANGE_BASE: ${{ env.CHANGE_BASE }}
        run: node --experimental-strip-types scripts/ci/ultra-fast.mjs
      - name: Require Ultra Fast evidence
        env:
          EXPECTED_SHA: ${{ github.event.pull_request.head.sha || github.sha }}
        run: |
          set -euo pipefail
          test -s diagnostics/investigation/ultra-fast.json
          node --experimental-strip-types -e "const fs=require('node:fs'); const r=JSON.parse(fs.readFileSync('diagnostics/investigation/ultra-fast.json','utf8')); if(r.sha!==process.env.EXPECTED_SHA || r.actualHeadSha!==process.env.EXPECTED_SHA || r.checksExecuted!==r.checksExpected) throw new Error('Invalid Ultra Fast evidence');"
      - name: Upload Ultra Fast evidence
        if: always()
        uses: actions/upload-artifact@v6
        with:
          name: ultra-fast-${{ github.event.pull_request.head.sha || github.sha }}
          path: diagnostics/investigation/ultra-fast.json
          if-no-files-found: error
          retention-days: 14
      - name: Finalize Ultra Fast triage status
        env:
          TRIAGE_OUTCOME: ${{ steps.triage.outcome }}
        run: test "$TRIAGE_OUTCOME" = success

  ultra-deep-recovery:
    name: Ultra — Deep Recovery (conditional)
    needs: [ultra-fast]
    if: needs.ultra-fast.result == 'failure'
    uses: ./.github/workflows/ultra-investigator.yml
    with:
      expected_sha: ${{ github.event.pull_request.head.sha || github.sha }}

  ci:
    name: CI
    needs: [matrix-first-barrier, ultra-fast]
    if: always() && needs.matrix-first-barrier.result == 'success'
    runs-on: ubuntu-latest
    timeout-minutes: 5
    env:
      CI_PR_RESCUE: 'true'
      EXPECTED_HEAD_SHA: ${{ github.event.pull_request.head.sha || github.sha }}
    steps:
      - uses: actions/checkout@v5
        with:
          ref: ${{ github.event.pull_request.head.sha || github.sha }}
          fetch-depth: 0
      - uses: actions/setup-node@v5
        with:
          node-version-file: .nvmrc
          cache: npm
      - run: npm ci --prefer-offline --no-audit --no-fund
      - run: node scripts/ci/fast-verify.mjs
      - uses: actions/upload-artifact@v6
        if: always()
        with:
          name: ci-fast-evidence-${{ github.sha }}
          path: diagnostics/
          if-no-files-found: warn
          retention-days: 14

  fast-contract:
    name: Fast Contract Diagnostics
    needs: [matrix-first-barrier, ultra-fast, ci]
    if: always() && needs.matrix-first-barrier.result == 'success'
    runs-on: ubuntu-latest
    env:
      EXPECTED_HEAD_SHA: ${{ github.event.pull_request.head.sha || github.sha }}
    timeout-minutes: 2
    steps:
      - uses: actions/download-artifact@v6
        with:
          name: ultra-fast-${{ github.event.pull_request.head.sha || github.sha }}
          path: diagnostics/investigation
      - if: ${{ needs.ci.result == 'success' }}
        uses: actions/download-artifact@v6
        with:
          name: ci-fast-evidence-${{ github.sha }}
          path: diagnostics
      - run: test -s diagnostics/investigation/ultra-fast.json
      - if: ${{ needs.ci.result == 'success' }}
        run: test -s diagnostics/fast-ci-plan.json && test -s diagnostics/fast-ci-result.json

  canonical-verify:
    name: Canonical Verification Gate
    needs: [matrix-first-barrier, ci, fast-contract]
    if: always() && needs.matrix-first-barrier.result == 'success'
    runs-on: ubuntu-latest
    timeout-minutes: 1
    steps:
      - name: Enforce prerequisite results
        run: |
          set -euo pipefail
          test "${{ needs.ci.result }}" = success
          test "${{ needs.fast-contract.result }}" = success

  g3-foundation:
    name: G3 / Foundation
    needs: [matrix-first-barrier]
    if: needs.matrix-first-barrier.result == 'success'
    runs-on: ubuntu-latest
    timeout-minutes: 12
    steps:
      - uses: actions/checkout@v5
        with:
          ref: ${{ github.event.pull_request.head.sha || github.sha }}
          fetch-depth: 0
      - uses: actions/setup-node@v5
        with:
          node-version-file: .nvmrc
          cache: npm
      - run: node scripts/ci/g3/identity.mjs
        env:
          EXPECTED_HEAD_SHA: ${{ github.event.pull_request.head.sha || github.sha }}
          BASE_SHA: ${{ github.event.pull_request.base.sha || '' }}
          MERGE_SHA: ${{ github.event.pull_request.merge_commit_sha || github.sha }}
      - if: always()
        run: node scripts/ci/g3/environment.mjs
        env:
          EXPECTED_HEAD_SHA: ${{ github.event.pull_request.head.sha || github.sha }}
          SITE_URL: https://flixoai.vercel.app
          TEST_ORIGIN: http://127.0.0.1:3000
          RUNTIME_ORIGIN: http://127.0.0.1:3000
          NODE_ENV: test
      - if: always()
        run: npm ci --prefer-offline --no-audit --no-fund
      - if: always()
        run: npx tsc --noEmit --pretty false
      - if: always()
        run: npm run lint
      - if: always()
        run: npm run build
      - uses: actions/upload-artifact@v6
        if: always()
        with:
          name: g3-foundation-${{ github.run_id }}
          path: artifacts/ci/g3/
          if-no-files-found: warn
          retention-days: 14

  g3-contracts:
    name: G3 / Contracts
    needs: [matrix-first-barrier]
    if: needs.matrix-first-barrier.result == 'success'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
        with:
          ref: ${{ github.event.pull_request.head.sha || github.sha }}
          fetch-depth: 0
      - uses: actions/setup-node@v5
        with:
          node-version-file: .nvmrc
          cache: npm
      - run: npm ci --prefer-offline --no-audit --no-fund
      - run: node --experimental-strip-types scripts/ci/g3/prepare-fixtures.mjs
      - run: node --experimental-strip-types scripts/ci/g3/artifact-gates.mjs
      - run: node --experimental-strip-types scripts/ci/g3/processor.mjs
      - run: node scripts/ci/g3/regression.mjs
      - run: node scripts/ci/g3/determinism.mjs
      - run: node scripts/test-g3-artifact-integrity.mjs

  g3-browser:
    name: G3 / Browser
    needs: [matrix-first-barrier]
    if: needs.matrix-first-barrier.result == 'success'
    runs-on: ubuntu-latest
    timeout-minutes: 30
    env:
      EXPECTED_HEAD_SHA: ${{ github.event.pull_request.head.sha || github.sha }}
      SITE_URL: https://flixoai.vercel.app
      TEST_ORIGIN: http://127.0.0.1:3000
      RUNTIME_ORIGIN: http://127.0.0.1:3000
      VITE_SITE_URL: https://flixoai.vercel.app
      VITE_TEST_ORIGIN: http://127.0.0.1:3000
      VITE_RUNTIME_ORIGIN: http://127.0.0.1:3000
      NODE_ENV: test
      PLAYWRIGHT_TEST_BASE_URL: http://127.0.0.1:3000
      PLAYWRIGHT_REUSE_SERVER: 'true'
    steps:
      - uses: actions/checkout@v5
        with:
          ref: ${{ github.event.pull_request.head.sha || github.sha }}
          fetch-depth: 0
      - uses: actions/setup-node@v5
        with:
          node-version-file: .nvmrc
          cache: npm
      - run: npm ci --prefer-offline --no-audit --no-fund
      - uses: actions/cache@v4
        with:
          path: ~/.cache/ms-playwright
          key: playwright-${{ runner.os }}-${{ hashFiles('package-lock.json') }}
      - name: Install Chromium if needed
        run: |
          executable="$(node -e "const { chromium }=require('playwright'); process.stdout.write(chromium.executablePath())")"
          test -x "$executable" || npx playwright install chromium
      - run: npm run build:runtime
      - run: npm run preview -- --host 127.0.0.1 --port 3000 > /tmp/flixo-g3-server.log 2>&1 &
      - run: node scripts/ci/g3/browser-gates.mjs

  g3-aggregator:
    name: G3 / Aggregator
    needs: [matrix-first-barrier, g3-foundation, g3-contracts, g3-browser]
    if: always() && needs.matrix-first-barrier.result == 'success'
    runs-on: ubuntu-latest
    timeout-minutes: 8
    steps:
      - uses: actions/checkout@v5
        with:
          ref: ${{ github.event.pull_request.head.sha || github.sha }}
          fetch-depth: 0
      - uses: actions/download-artifact@v6
        with:
          pattern: g3-*
          path: artifacts/ci/g3/all
          merge-multiple: false
      - name: Resolve legacy G3
        id: legacy-g3
        env:
          GH_TOKEN: ${{ github.token }}
          REPOSITORY: ${{ github.repository }}
          HEAD_SHA: ${{ github.event.pull_request.head.sha || github.sha }}
        shell: bash
        run: |
          set -euo pipefail
          conclusion="NOT_FOUND"
          for attempt in {1..60}; do
            conclusion=$(gh api "repos/$REPOSITORY/commits/$HEAD_SHA/check-runs?per_page=100" --jq '[.check_runs[] | select(.name=="G3 Artifact Integrity Shadow") | select(.head_sha==env.HEAD_SHA)] | sort_by(.completed_at) | last | .conclusion // "NOT_FOUND"')
            case "$conclusion" in success|failure|cancelled|timed_out|action_required|neutral|skipped|stale) break;; *) sleep 5;; esac
          done
          test "$conclusion" != NOT_FOUND
          echo "legacy_result=$conclusion" >> "$GITHUB_OUTPUT"
      - name: G3 authoritative aggregation
        env:
          EXPECTED_HEAD_SHA: ${{ github.event.pull_request.head.sha || github.sha }}
          HEAD_SHA: ${{ github.event.pull_request.head.sha || github.sha }}
          BASE_SHA: ${{ github.event.pull_request.base.sha || '' }}
          MERGE_SHA: ${{ github.event.pull_request.merge_commit_sha || github.sha }}
          LEGACY_RESULT: ${{ steps.legacy-g3.outputs.legacy_result }}
          FOUNDATION_RESULT: ${{ needs.g3-foundation.result }}
        run: node scripts/ci/g3/aggregate.mjs

  final-contract-gate:
    name: Final Contract Decision
    needs: [matrix-first-barrier, ultra-fast, ultra-deep-recovery, ci, fast-contract, canonical-verify, g3-aggregator]
    if: always()
    runs-on: ubuntu-latest
    timeout-minutes: 2
    steps:
      - name: Enforce final decision graph
        shell: bash
        env:
          MATRIX_FIRST_RESULT: ${{ needs.matrix-first-barrier.result }}
          ULTRA_FAST_RESULT: ${{ needs.ultra-fast.result }}
          ULTRA_DEEP_RESULT: ${{ needs.ultra-deep-recovery.result }}
          CI_RESULT: ${{ needs.ci.result }}
          FAST_CONTRACT_RESULT: ${{ needs.fast-contract.result }}
          CANONICAL_RESULT: ${{ needs.canonical-verify.result }}
          G3_RESULT: ${{ needs.g3-aggregator.result }}
        run: |
          set -euo pipefail
          test "$MATRIX_FIRST_RESULT" = success
          test "$CI_RESULT" = success
          test "$FAST_CONTRACT_RESULT" = success
          test "$CANONICAL_RESULT" = success
          test "$G3_RESULT" = success
          if [[ "$ULTRA_FAST_RESULT" == "failure" ]]; then test "$ULTRA_DEEP_RESULT" = success; fi
