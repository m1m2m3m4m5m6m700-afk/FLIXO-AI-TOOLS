{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flixoai",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
