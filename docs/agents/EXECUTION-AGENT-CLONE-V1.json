{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 1,
  "id": "execution-agent-clone-v1",
  "displayName": "Execution Agent Clone v1",
  "status": "ACTIVE",
  "cloneType": "COGNITIVE_CLONE",
  "role": "executionAgent",
  "rolePreserved": true,
  "sourceRuntime": {
    "ui": "src/components/FlixoAIAgentStudio.tsx",
    "agent": "src/components/FlixoAIAgent.tsx",
    "conversation": "src/lib/agent/human-conversation.ts",
    "cognitiveOrchestrator": "src/lib/agent/cognitive-orchestrator.ts",
    "learningPersistence": "src/server/agent/learning-persistence.ts"
  },
  "intelligence": {
    "version": "FLIXO-BOT-BRAIN-v1",
    "registry": "docs/agents/FLIXO-BOT.json",
    "registryPath": "docs/agents/FLIXO-BOT.json#/mergedIntelligence",
    "capabilityParity": "EXACT",
    "capabilitySetIsSharedByReference": true,
    "capabilityCountSource": "docs/agents/FLIXO-BOT.json#/mergedIntelligence/capabilityCount"
  },
  "memory": {
    "protocol": "FLIXO-SHARED-OPERATIONAL-MEMORY-v1",
    "canonicalStore": "diagnostics/auto-repair/SHARED-OPERATIONAL-MEMORY.json",
    "readMode": "SYSTEM_WIDE",
    "writeMode": "PUBLISHED_LESSON_OR_OPERATION_ONLY",
    "exactShaBound": true,
    "provenanceRequired": true,
    "staleKnowledgePolicy": "REQUALIFY_BEFORE_REUSE",
    "remoteMirrorPolicy": "Only exact-target-SHA candidates are admitted into the shared context; PROPOSED knowledge remains advisory until internal verification and canonical GREEN."
  },
  "bidirectionalSync": {
    "protocol": "FLIXO-BIDIRECTIONAL-COGNITIVE-MESH-v1",
    "cloneToSystem": {
      "enabled": true,
      "mechanism": "publishSharedMemory",
      "result": "VISIBLE_TO_ALL_ACTIVE_CONSUMERS"
    },
    "systemToClone": {
      "enabled": true,
      "mechanism": "buildSharedLearningContext",
      "result": "ALL_ACTIVE_AGENT_AND_BOT_LEARNING_IS_VISIBLE_TO_CLONE"
    },
    "syncModel": "LIVE_SHARED_MEMORY_BY_REFERENCE",
    "oneCanonicalBrain": true,
    "noLocalFork": true,
    "noSecondRegistry": true,
    "durableIngress": {
      "enabled": true,
      "persistenceTable": "public.flixo_agent_learning_events",
      "apiSurface": "api/flixo-agent.ts",
      "syncRuntime": "scripts/ci/sync-cognitive-learning-mesh.mjs",
      "externalToInternal": "PROPOSED candidate → sync → SHARED-OPERATIONAL-MEMORY",
      "internalToExternal": "VERIFIED/PROMOTED canonical memory → durable mirror → external UI context"
    }
  },
  "authority": {
    "knowledgeDoesNotGrantAuthority": true,
    "directPermissionGrant": false,
    "canMutateMain": false,
    "canMutateTests": false,
    "canMutateProtectedControlPlane": false,
    "certificationAuthority": false,
    "mergeAuthority": false,
    "roleAuthorityResolution": "EXISTING_EXECUTION_AGENT_ADMISSION_AND_CHAIR_PROTOCOL",
    "singleMutableOwnerPerTask": true
  },
  "verification": {
    "currentShaRequired": true,
    "newPushInvalidatesPriorProof": true,
    "canonicalGreenRemainsAuthoritative": true
  }
}
