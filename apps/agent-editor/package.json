{
  "name": "flixo-agent-editor",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node scripts/stage-ffmpeg-core.mjs && next dev",
    "build": "node scripts/stage-ffmpeg-core.mjs && next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "jszip": "3.10.2",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.16.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.8.3",
    "vitest": "5.0.2",
    "@playwright/test": "1.63.0",
    "@vitest/coverage-v8": "5.0.2"
  }
}
