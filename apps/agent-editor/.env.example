# Production LLM provider configuration.
# Keep provider keys server-side. Never expose them through NEXT_PUBLIC_* variables.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Model IDs are required when the corresponding provider key is configured.
FLIXO_LLM_OPENAI_MODEL=
FLIXO_LLM_ANTHROPIC_MODEL=
FLIXO_LLM_GEMINI_MODEL=
FLIXO_LLM_MAX_OUTPUT_TOKENS=2048

# Optional AES-256-GCM encrypted credential envelope.
# FLIXO_LLM_KEY_ENCRYPTION_KEY must be a base64-encoded 32-byte key.
# FLIXO_LLM_KEYS_ENCRYPTED is a JSON object containing iv/tag/data per provider.
FLIXO_LLM_KEY_ENCRYPTION_KEY=
FLIXO_LLM_KEYS_ENCRYPTED=

# Deterministic mock mode is test-only. Keep false in production.
FLIXO_ENABLE_MOCK_LLM=false

# Production rate limiting is fail-closed by default.
# Set false only for local/CI environments that intentionally omit Upstash.
FLIXO_RATE_LIMIT_FAIL_CLOSED=true
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
