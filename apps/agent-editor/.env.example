# Production LLM provider configuration.
# Provider keys must remain server-side. Never use NEXT_PUBLIC_* for credentials.
# Development/CI may use direct provider env vars. Production requires the encrypted envelope below.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

FLIXO_LLM_OPENAI_MODEL=
FLIXO_LLM_ANTHROPIC_MODEL=
FLIXO_LLM_GEMINI_MODEL=
FLIXO_LLM_MAX_OUTPUT_TOKENS=2048

# Production credential envelope: AES-256-GCM.
# FLIXO_LLM_KEY_ENCRYPTION_KEY is a base64-encoded 32-byte key.
# FLIXO_LLM_KEYS_ENCRYPTED is a JSON object with { iv, tag, data } per provider.
FLIXO_LLM_KEY_ENCRYPTION_KEY=
FLIXO_LLM_KEYS_ENCRYPTED=

# Deterministic mock mode is test-only and is rejected in production.
FLIXO_ENABLE_MOCK_LLM=false

# Production rate limiting is fail-closed by default.
FLIXO_RATE_LIMIT_FAIL_CLOSED=true
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
