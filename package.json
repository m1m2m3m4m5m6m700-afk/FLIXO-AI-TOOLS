{
  "name": "flixo-tools",
  "private": true,
  "type": "module",
  "engines": { "node": "22.x" },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "npm run validate:site-origin && vite build && FLIXO_GENERATED_OUTPUT_DIR=dist npm run generate:robots && FLIXO_GENERATED_OUTPUT_DIR=dist npm run generate:sitemap",
    "build:runtime": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "validate:s2d": "node scripts/validate-s2d.mjs",
    "validate:dependency-zero-debt": "node scripts/validate-dependency-zero-debt.mjs",
    "validate:lock-manifest": "node scripts/validate-lock-manifest-contract.mjs",
    "validate:playwright-surface": "node scripts/ci/validate-playwright-surface.mjs",
    "validate:assertion-registry": "node scripts/ci/validate-assertion-registry.mjs",
    "validate:agent-protocol": "node scripts/ci/validate-agent-protocol.mjs",
    "validate:agent-coordination": "node scripts/ci/validate-agent-coordination.mjs",
    "agent:coordination": "node scripts/ci/agent-coordination.mjs",
    "validate:i18n": "node scripts/validate-i18n.mjs",
    "validate:language-quality": "node scripts/validate-language-quality.mjs",
    "validate:locale-navigation": "node scripts/validate-locale-navigation.mjs",
    "validate:home-i18n": "node scripts/validate-home-localization.mjs",
    "validate:seo": "node scripts/validate-seo.mjs",
    "validate:seo-manifest": "node scripts/validate-seo-manifest.mjs",
    "validate:indexing": "node scripts/validate-indexing.mjs",
    "validate:breadcrumb-seo": "node scripts/validate-breadcrumb-seo.mjs",
    "validate:ci-contract": "node scripts/validate-ci-contract.mjs",
    "validate:contracts": "node --experimental-strip-types scripts/validate-contracts.mjs",
    "validate:localization-full": "node scripts/validate-localization-full.mjs",
    "validate:localization-complete": "node --import=./scripts/register-node-resolver.mjs --experimental-strip-types scripts/validate-localization-complete.mjs",
    "verify:i18n": "node --import=./scripts/register-node-resolver.mjs --experimental-strip-types scripts/validate-localization-complete.mjs --strict --report",
    "validate:tool-registry": "node scripts/validate-tool-registry-contract.mjs",
    "validate:tool-manifest": "node --import=./scripts/register-node-resolver.mjs --experimental-strip-types scripts/validate-tool-manifest.mjs",
    "validate:tool-definition": "node scripts/validate-tool-definition-contract.mjs",
    "validate:baseline": "node scripts/validate-engineering-baseline.mjs",
    "validate:router-registry": "node --import=./scripts/register-node-resolver.mjs --experimental-strip-types scripts/validate-router-registry.mjs",
    "validate:site-origin": "node --import=./scripts/register-node-resolver.mjs --experimental-strip-types scripts/validate-site-origin.mjs",
    "validate:image-only-closure": "node scripts/validate-image-only-closure.mjs",
    "report:localization": "node scripts/report-localization-coverage.mjs",
    "report:dependency-health": "node scripts/report-dependency-health.mjs",
    "report:dependency-trace": "node scripts/report-dependency-trace.mjs",
    "report:heavy-dependency-usage": "node scripts/report-heavy-dependency-usage.mjs",
    "report:complexity": "node scripts/report-complexity-debt.mjs",
    "report:bundle-size": "node scripts/report-bundle-size.mjs",
    "validate:performance-budget": "node scripts/validate-performance-budget.mjs",
    "report:performance-baseline": "node scripts/report-performance-baseline.mjs",
    "generate:robots": "node --import=./scripts/register-node-resolver.mjs --experimental-strip-types scripts/generate-robots.mjs",
    "generate:sitemap": "node --import=./scripts/register-node-resolver.mjs --experimental-strip-types scripts/generate-sitemap.mjs",
    "test:quickflow": "node --import=./scripts/register-node-resolver.mjs --experimental-strip-types scripts/test-quickflow-contract.mjs",
    "test:agent-capability": "node --import=./scripts/register-node-resolver.mjs --experimental-strip-types scripts/test-agent-capability-registry.mjs",
    "test:ai-planner": "node --import=./scripts/register-node-resolver.mjs --experimental-strip-types scripts/test-ai-planner.mjs",
    "test:agent-self-correction": "node --import=./scripts/register-node-resolver.mjs --experimental-strip-types scripts/test-agent-self-correction.mjs",
    "test:llm-provider": "node --import=./scripts/register-node-resolver.mjs --experimental-strip-types scripts/test-llm-provider.mjs",
    "test:i18n": "node --experimental-strip-types scripts/test-i18n-contract.mjs",
    "test:route-resolver": "node --import=./scripts/register-node-resolver.mjs --experimental-strip-types scripts/test-route-resolver.mjs",
    "test:upload-boundary": "node --experimental-strip-types scripts/test-upload-boundary.mjs",
    "test:tool-localization": "node --import=./scripts/register-node-resolver.mjs --experimental-strip-types scripts/test-tool-localization-contract.mjs",
    "test:image-core": "node --import=./scripts/register-node-resolver.mjs --experimental-strip-types scripts/test-image-core-contract.mjs",
    "test:tool-platform": "node --import=./scripts/register-node-resolver.mjs --experimental-strip-types scripts/test-tool-platform-catalog.mjs",
    "test:unified-audit": "node scripts/test-unified-audit-contract.mjs",
    "validate:i18n-observer-boundary": "node scripts/validate-i18n-observer-boundary.mjs",
    "test:unit": "npm run test:quickflow && npm run test:agent-capability && npm run test:ai-planner && npm run test:agent-self-correction && npm run test:llm-provider && npm run test:i18n && npm run test:route-resolver && npm run test:upload-boundary && npm run test:image-core && npm run test:tool-platform && npm run validate:i18n-observer-boundary && npm run validate:tool-definition && npm run test:unified-audit",
    "test:diagnose": "node scripts/test.mjs --mode=diagnose",
    "test:static": "npm run orchestrate && node scripts/test.mjs --mode=diagnose --gate=static",
    "test:build": "node scripts/test.mjs --mode=diagnose --gate=build",
    "test:browser": "node scripts/test.mjs --mode=diagnose --gate=browser",
    "audit:technical-debt": "node scripts/ci/audit-technical-debt.mjs",
    "verify:contracts": "npm run test:static",
    "verify:fast": "npm run test:static",
    "orchestrate": "node scripts/ci/unified-orchestrator.mjs",
    "check": "npm run test:static && npm run test:build",
    "verify": "npm run check && npm run audit:production",
    "test:e2e": "playwright test",
    "test": "npm run verify && npm run test:e2e"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@tanstack/react-router": "1.170.32",
    "jszip": "^3.10.1",
    "lucide-react": "^0.575.0",
    "motion": "^12.43.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^15.15.0",
    "playwright": "^1.62.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.2.1"
  }
}