{
  "name": "flixo-tools",
  "private": true,
  "type": "module",
  "engines": { "node": "22.x" },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "npm run typecheck && npm run lint && vite build && FLIXO_GENERATED_OUTPUT_DIR=dist npm run generate:robots && FLIXO_GENERATED_OUTPUT_DIR=dist npm run generate:sitemap && npm run generate:static-routes",
    "build:runtime": "vite build",
    "preview": "node --import=./scripts/register-node-resolver.mjs --experimental-strip-types scripts/preview-with-api.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "npx --yes prettier@3.6.2 --check .",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "generate:robots": "node scripts/generate-robots.mjs",
    "generate:sitemap": "node --import=./scripts/register-node-resolver.mjs --experimental-strip-types scripts/generate-sitemap.mjs",
    "generate:static-routes": "node --import=./scripts/register-node-resolver.mjs --experimental-strip-types scripts/generate-static-route-entries.mjs",
    "test:core": "node --test --experimental-strip-types tests/core-contracts.test.ts",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && npm run lint && npm run test:core",
    "ci": "npm run test && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@tanstack/react-router": "1.170.32",
    "jszip": "^3.10.1",
    "lucide-react": "^0.575.0",
    "motion": "^12.43.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^15.15.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.2.1"
  }
}