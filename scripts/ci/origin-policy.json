{
  "schema_version": 3,
  "authority": "canonical-origin-policy",
  "productionOrigin": "https://flixoai.vercel.app",
  "runtimeOrigin": "http://127.0.0.1:3000",
  "testSentinel": "https://canonical.test",
  "testSentinelPolicy": "UNIT_OR_CONTRACT_ONLY",
  "certificationProvenanceForbidden": ["https://canonical.test"],
  "sentinelAllowlist": [
    "scripts/test-route-resolver.mjs",
    "scripts/test-i18n-contract.mjs"
  ],
  "nonCertificationDiagnosticAllowlist": [
    "scripts/validate-s3-static-gate.mjs"
  ],
  "workflowCertificationAllowlist": [
    ".github/workflows/ci.yml"
  ]
}
