# Canonical production origin used for canonical URLs, hreflang, sitemap, and robots.
# Required for local verify/test commands that exercise canonical SEO contracts.
# Never use localhost, loopback, or a Vercel deployment/preview hostname.
VITE_SITE_URL=https://flixoai.vercel.app

# Optional server-side CSRF signing secret. Use at least 32 random characters in production.
FLIXO_CSRF_SECRET=

# Optional AI runtime configuration. Keep provider credentials server-side only.
FLIXO_AI_DEFAULT_MAX_TOKENS=
FLIXO_AI_MAX_INPUT_CHARS=
# Which AI provider the AI task pipeline + chatbot use. "openai" (default), "gemini", or "openrouter".
FLIXO_AI_PROVIDER=
FLIXO_AI_FALLBACK_PROVIDER=
FLIXO_AI_TIMEOUT_MS=
GITHUB_APP_CALLBACK_URL=
GITHUB_BRANCH=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Optional client-visible analytics configuration only; never place provider secrets here.
VITE_ANALYTICS_DEBUG=
VITE_CLARITY_PROJECT_ID=
VITE_ENABLE_ANALYTICS=
VITE_GA_MEASUREMENT_ID=

# External GPT Council runtime. Server-side only.
COUNCIL_RUNTIME_URL=https://zrpsmgdrtwzrhkjwwujo.supabase.co/functions/v1/flixo-council-runtime
COUNCIL_CHIEF_TOKEN=
COUNCIL_WORKER_A_TOKEN=
COUNCIL_WORKER_B_TOKEN=
COUNCIL_WORKER_A_WAKE_ENDPOINT=
COUNCIL_WORKER_B_WAKE_ENDPOINT=

# External GPT bridge runtime. One persistent bridge process is required per account.
COUNCIL_ACCOUNT_ID=
COUNCIL_BRIDGE_POLL_MS=5000
COUNCIL_CHIEF_BRIDGE_PORT=8781
COUNCIL_WORKER_A_BRIDGE_PORT=8782
COUNCIL_WORKER_B_BRIDGE_PORT=8783
COUNCIL_CHIEF_AGENT_ENDPOINT=
COUNCIL_WORKER_A_AGENT_ENDPOINT=
COUNCIL_WORKER_B_AGENT_ENDPOINT=
COUNCIL_CHIEF_AGENT_TOKEN=
COUNCIL_WORKER_A_AGENT_TOKEN=
COUNCIL_WORKER_B_AGENT_TOKEN=

# Action-agent frontier reasoning profiles (optional; provider-neutral)
COUNCIL_CHIEF_MODEL_PROFILE=FRONTIER_REASONING
COUNCIL_CHIEF_REASONING_EFFORT=HIGH
COUNCIL_WORKER_A_MODEL_PROFILE=FRONTIER_CODING_REASONING
COUNCIL_WORKER_A_REASONING_EFFORT=MAXIMUM
COUNCIL_WORKER_B_MODEL_PROFILE=FRONTIER_ADVERSARIAL_REASONING
COUNCIL_WORKER_B_REASONING_EFFORT=MAXIMUM
