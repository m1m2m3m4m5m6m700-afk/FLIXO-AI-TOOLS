{
  "schemaVersion": 4,
  "id": "ACTION-THREE-BOT-INTELLIGENCE",
  "purpose": "Canonical specialized intelligence contract for the three Action Vault roles: programmer, historical predictor, and failure historian.",
  "parity": {
    "model": "ROLE_SPECIALIZATION_WITH_SHARED_SAFETY",
    "commonSafetyEqual": true,
    "commonIdentityBindingEqual": true,
    "roleCapabilitiesEqual": false,
    "independentAuthorityEqual": false
  },
  "capabilities": [
    "CURRENT_ACTION_LOG_ANALYSIS",
    "EXACT_SHA_PROVENANCE_ANALYSIS",
    "FAILURE_FINGERPRINTING",
    "HISTORICAL_INDEX_SEARCH",
    "ACTION_INDEX_4000_SEARCH",
    "REPAIR_MEMORY_SEARCH",
    "ERROR_TEACHING_5000_SEARCH",
    "ROOT_CAUSE_ANALYSIS",
    "INFERENTIAL_REPAIR",
    "CROSS_CASE_SYNTHESIS",
    "PLAYBOOK_REUSE",
    "ANTI_LESSON_DETECTION",
    "PREDICTIVE_FAILURE_CLASS_ORDERING",
    "TARGETED_REGRESSION_PLANNING",
    "MINIMAL_SOURCE_CHANGE_PLANNING",
    "BOT_TO_BOT_CHALLENGE",
    "TASK_HANDOFF",
    "LESSON_AND_ANTILESSON_LEARNING",
    "FIRST_SEEN_DETECTION",
    "MASTER_ESCALATION",
    "GREEN_CHAIN_INTERPRETATION",
    "EXTERNAL_BLOCK_CLASSIFICATION",
    "CODE_MENTOR_GUIDANCE",
    "TYPE_AND_CONTRACT_REVIEW",
    "CI_CODE_PATTERN_TEACHING",
    "PROGRAMMER_THINKING",
    "HISTORICAL_PREDICTION",
    "FAILURE_LEDGER",
    "CANDIDATE_REPAIR_SYNTHESIS"
  ],
  "sharedSources": [
    "diagnostics/auto-repair/action-vault/ACTION-INDEX-4000.json",
    "docs/agents/historical-action-errors/index.json",
    "docs/agents/historical-action-errors/records",
    "diagnostics/auto-repair/memory.json",
    "docs/agents/HISTORICAL-REPAIR-KNOWLEDGE.json",
    "docs/agents/ERROR-TEACHING-ROUTER.json",
    "docs/agents/ERROR-TEACHING-500.md",
    "docs/agents/ERROR-TEACHING-ADDITIONAL-500.md",
    "docs/agents/ERROR-TEACHING-EXPANDED-A-1000.md",
    "docs/agents/ERROR-TEACHING-EXPANDED-B-1000.md",
    "docs/agents/ERROR-TEACHING-EXPANDED-C-1000.md",
    "docs/agents/ERROR-TEACHING-EXPANDED-D-1000.md",
    "docs/agents/INFERENTIAL-REPAIR-INTELLIGENCE.md",
    "docs/agents/ACTION-AGENT-RUNTIME-PROTOCOL.md",
    "docs/agents/historical-action-errors/agent-activity/index.json",
    "docs/agents/historical-action-errors/agent-activity",
    "diagnostics/auto-repair/action-vault/ACTION-CODE-MENTOR.json",
    "scripts/ci/action-code-mentor.mjs"
  ],
  "safetyBoundary": {
    "intelligenceDoesNotImplyMutationAuthority": true,
    "canonicalCiRemainsProofAuthority": true,
    "exactShaRequiredForActionableDecision": true,
    "testMutationForbidden": true,
    "mainMutationForbidden": true,
    "protectedControlPlaneMutationForbidden": true,
    "externalFailureCannotBecomeInternalRepair": true,
    "oneActiveRepairOwnerPerTask": true,
    "agent2SourceMutationForbidden": true,
    "agent3SourceMutationForbidden": true,
    "agent1OwnerOnlyMutation": true,
    "predictionIsNotProof": true,
    "failureLedgerAppendOnly": true
  },
  "members": [
    {
      "id": "ACTION-REPAIR",
      "role": "PRIMARY_PROGRAMMING_REPAIR_OWNER",
      "executionAuthority": "MUTATE_WHEN_TASK_OWNER"
    },
    {
      "id": "ACTION-REPAIR-2",
      "role": "HISTORICAL_INDEX_EXPLORER_AND_PREDICTOR",
      "executionAuthority": "PROPOSE_ONLY"
    },
    {
      "id": "ACTION-HISTORIAN-3",
      "role": "FAILURE_LEDGER_AND_LEARNING_RECORDER",
      "executionAuthority": "RECORD_INDEX_ESCALATE_ONLY"
    }
  ],
  "note": "The three bots have capability parity and mandatory collaboration on each actionable RED. Mutation authority remains role-scoped so cooperation cannot create concurrent source writes.",
  "cooperation": {
    "enabled": true,
    "trigger": "ANY_ACTIONABLE_RED",
    "missionModel": "ONE_SHARED_TASK",
    "identityBinding": [
      "taskId",
      "failureFingerprint",
      "targetSha",
      "failedRunId"
    ],
    "participants": [
      "ACTION-REPAIR",
      "ACTION-REPAIR-2",
      "ACTION-HISTORIAN-3"
    ],
    "requiredWork": [
      "ACTION-HISTORIAN-3 records the exact RED before repair reasoning proceeds",
      "ACTION-REPAIR-2 searches historical indexes and repair catalog and produces a ranked predictive repair packet",
      "ACTION-REPAIR reads the code as a programmer and combines current evidence with the predictive packet",
      "ACTION-REPAIR may apply the minimal source repair only as active owner",
      "ACTION-HISTORIAN-3 records every attempt and every failure regardless of outcome",
      "prediction packets remain provisional until exact-SHA verification and Canonical GREEN",
      "Canonical GREEN closes the mission and promotes only verified lessons"
    ],
    "contributionOrder": [
      "ACTION-HISTORIAN-3: FAILURE_INTAKE_AND_LEDGER",
      "ACTION-REPAIR-2: INDEX_EXPLORATION_AND_PREDICTION",
      "ACTION-REPAIR: PROGRAMMER_REASONING_AND_REPAIR",
      "ACTION-HISTORIAN-3: FAILURE/ATTEMPT/GREEN LEDGER UPDATE"
    ],
    "authority": {
      "taskOwnership": "single_active_programming_owner",
      "repairOwner": "ACTION-REPAIR",
      "predictionOwner": "ACTION-REPAIR-2",
      "historian": "ACTION-HISTORIAN-3",
      "noParallelSourceMutation": true,
      "predictionCannotAuthorizeMutation": true,
      "canonicalGreen": "DAILY_FLIXO_GREEN_GATE"
    },
    "sharedArtifact": "diagnostics/auto-repair/action-vault/current-collaboration.json",
    "hardRule": "ANY_ACTIONABLE_RED_REQUIRES_ALL_THREE_TO_CONTRIBUTE_BEFORE_OWNER_MUTATION",
    "parallelExecution": {
      "cognitiveParallelism": true,
      "sourceMutationParallelism": false,
      "lanes": {
        "ACTION-REPAIR": "PRIMARY_EXECUTION_RCA_AND_BOUNDED_REPAIR",
        "ACTION-REPAIR-2": "INDEPENDENT_RCA_CHALLENGE_AND_FALSIFICATION",
        "ACTION-HISTORIAN-3": "EVIDENCE_INTAKE_INDEX_PROVENANCE_AND_LEARNING"
      },
      "phases": [
        "PARALLEL_DISCOVERY",
        "PARALLEL_ANALYSIS",
        "CROSS_LEARNING",
        "CHALLENGE",
        "SYNTHESIS",
        "OWNER_MUTATION",
        "VERIFICATION",
        "GREEN_LEARNING",
        "CLOSED"
      ],
      "allThreeContributionsRequired": true,
      "exchangeBeforeMutation": true,
      "peerLearningReceiptsRequired": true,
      "oneActiveMutationOwner": true,
      "greenOnlyClosure": true
    },
    "sharedLearning": {
      "provisionalDuringRed": true,
      "promotedOnlyAfterCanonicalGreen": true,
      "evidenceBinding": [
        "taskId",
        "failureFingerprint",
        "targetSha",
        "failedRunId"
      ],
      "crossLearningRequired": true
    },
    "targetedRepair": {
      "protocolRef": "docs/agents/ACTION-VAULT-TARGETED-REPAIR-PROTOCOL.md",
      "planner": "scripts/ci/action-vault-targeted-test.mjs",
      "rule": "REPAIR_AND_RETEST_ONLY_THE_IMPACTED_SURFACE_FIRST",
      "fullSuiteInFastLoop": false,
      "exactShaRequired": true,
      "canonicalGreenRequired": true,
      "runtimePacket": "scripts/ci/action-agent-runtime.mjs"
    },
    "mentorship": {
      "enabled": true,
      "provider": "ACTION-CODE-MENTOR",
      "parentBot": "ACTION-REPAIR",
      "readOnly": true,
      "exactShaRequired": true,
      "invokeBeforeOwnerMutation": true,
      "invokeDuringSelfCheck": true,
      "learners": [
        "ACTION-REPAIR",
        "ACTION-REPAIR-2",
        "ACTION-HISTORIAN-3"
      ],
      "packet": "CODE_MENTOR_PACKET_V1",
      "provisionalDuringRed": true,
      "promotedOnlyAfterCanonicalGreen": true,
      "hardRule": "MENTOR_GUIDANCE_MUST_NEVER_BE_TREATED_AS_PROOF_OR_AUTHORITY"
    },
    "roleExchange": {
      "requiredArtifacts": [
        "ACTION-HISTORIAN-3:failure-ledger-record",
        "ACTION-REPAIR-2:predictive-repair-packet",
        "ACTION-REPAIR:programmer-analysis"
      ],
      "beforeMutation": "ALL_REQUIRED_ARTIFACTS_PRESENT",
      "onPredictionFailure": "ACTION-REPAIR-2_REISSUES_PREDICTION_WITH_COUNTEREXAMPLES",
      "onRepairFailure": "ACTION-HISTORIAN-3_RECORDS_AND_ACTION-REPAIR_REANALYZES",
      "noAutomaticGreen": "true"
    },
    "prediction": {
      "runtime": "scripts/ci/action-historical-predictor.mjs",
      "output": "diagnostics/auto-repair/action-vault/historical-predictions/latest.json",
      "packetProtocol": "PREDICTIVE_REPAIR_PACKET_V1",
      "provisional": true,
      "exactShaBound": true,
      "ownerReviewRequired": true
    },
    "failureLedger": {
      "runtime": "scripts/ci/action-failure-ledger.mjs",
      "output": "diagnostics/auto-repair/action-vault/failure-ledger.ndjson",
      "appendOnly": true,
      "recordEveryFailure": true,
      "recordEveryAttempt": true,
      "recordEveryHandoff": true,
      "promoteLearningOnlyAfterGreen": true
    }
  },
  "residencyPolicyRef": "diagnostics/auto-repair/action-vault/ACTION-RESIDENCY-POLICY.json",
  "residency": {
    "alwaysResident": true,
    "leaveVault": false,
    "maxOperationsPerBot": 2000000,
    "visitsPerBotPerDay": 3,
    "totalAutomaticVisitsPerDay": 9,
    "closure": "CANONICAL_GREEN_ONLY",
    "escalationAfterFailedAttempts": 20,
    "supervisorRoute": "scripts/ci/agent-communication.mjs -> .github/workflows/agent-communication-relay.yml -> assistantController"
  },
  "agentRuntime": {
    "protocol": "ACTION-AGENT-RUNTIME-v1",
    "runtimeScript": "scripts/ci/action-agent-runtime.mjs",
    "historyScript": "scripts/ci/action-agent-history.mjs",
    "phases": [
      "INTAKE",
      "CONTEXT_RETRIEVAL",
      "PLAN",
      "EXECUTE",
      "SELF_CHECK",
      "INDEPENDENT_REVIEW",
      "VERIFY",
      "LEARN"
    ],
    "exactIdentity": [
      "taskId",
      "failureFingerprint",
      "targetSha",
      "failedRunId"
    ],
    "requirements": {
      "evidenceFirst": true,
      "historicalFirst": true,
      "explicitUnknowns": true,
      "selfCritique": true,
      "independentReview": true,
      "structuredOutput": true,
      "toolBudget": true,
      "noSelfApproval": true
    },
    "efficiency": {
      "parallelCognitiveReads": true,
      "parallelHistoricalRetrieval": true,
      "serializedSourceMutation": true,
      "targetedRegressionFirst": true,
      "fullSuiteInFastLoop": false
    },
    "modelProfiles": {
      "chief": "FRONTIER_REASONING",
      "primary": "FRONTIER_CODING_REASONING",
      "historicalPredictor": "FRONTIER_HISTORICAL_REASONING",
      "failureHistorian": "FRONTIER_FORENSIC_REASONING"
    }
  },
  "roleMatrix": {
    "ACTION-REPAIR": {
      "role": "PRIMARY_PROGRAMMING_REPAIR_OWNER",
      "mission": "THINK_AS_PROGRAMMER_AND_APPLY_BOUNDED_SOURCE_REPAIR",
      "capabilities": [
        "CURRENT_ACTION_LOG_ANALYSIS",
        "EXACT_SHA_PROVENANCE_ANALYSIS",
        "ROOT_CAUSE_ANALYSIS",
        "AST_CODE_REASONING",
        "CODE_MENTOR_GUIDANCE",
        "MINIMAL_PATCH",
        "REGRESSION_DESIGN",
        "SELF_CRITIQUE",
        "VERIFICATION",
        "CAN_MUTATE_SOURCE_WHEN_OWNER"
      ],
      "mutationAuthority": "OWNER_ONLY",
      "requiredInputs": [
        "ACTION-REPAIR-2:PREDICTIVE_REPAIR_PACKET",
        "ACTION-HISTORIAN-3:FAILURE_LEDGER_RECORD"
      ]
    },
    "ACTION-REPAIR-2": {
      "role": "HISTORICAL_INDEX_EXPLORER_AND_PREDICTOR",
      "mission": "SEARCH_HISTORICAL_INDEX_AND_ACTION_REPAIR_CATALOG_THEN_PREDICT_A_CANDIDATE_SOLUTION",
      "capabilities": [
        "HISTORICAL_INDEX_SEARCH",
        "ACTION_INDEX_4000_SEARCH",
        "REPAIR_MEMORY_SEARCH",
        "HISTORICAL_CASE_MATCHING",
        "SOLUTION_RETRIEVAL",
        "PATTERN_RANKING",
        "PREDICTIVE_REPAIR",
        "COUNTEREXAMPLE_SEARCH",
        "CANDIDATE_PATCH_PLANNING",
        "OWNER_HANDOFF"
      ],
      "mutationAuthority": "NONE",
      "output": "PROVISIONAL_PREDICTIVE_REPAIR_PACKET"
    },
    "ACTION-HISTORIAN-3": {
      "role": "FAILURE_LEDGER_AND_LEARNING_RECORDER",
      "mission": "RECORD_EVERY_FAILURE_ATTEMPT_HANDOFF_AND_VERIFIED_OUTCOME_FOR_LIFELONG_REPAIR_MEMORY",
      "capabilities": [
        "FAILURE_INTAKE",
        "EXACT_PROVENANCE",
        "ATTEMPT_LEDGER",
        "FAILURE_LEDGER",
        "HANDOFF_LEDGER",
        "LESSON_EXTRACTION",
        "ANTI_LESSON_EXTRACTION",
        "GREEN_CHAIN_RECORDING",
        "MASTER_ESCALATION"
      ],
      "mutationAuthority": "ACTION_VAULT_MEMORY_ONLY",
      "output": "APPEND_ONLY_FAILURE_LEDGER"
    }
  }
}
