{
  "schemaVersion": 3,
  "id": "ACTION-THREE-BOT-INTELLIGENCE",
  "purpose": "Canonical shared intelligence and capability contract for ACTION-REPAIR, ACTION-REPAIR-2 and ACTION-HISTORIAN-3.",
  "parity": {
    "cognitiveCapabilitiesEqual": true,
    "knowledgeSourcesEqual": true,
    "reasoningModesEqual": true,
    "searchAccessEqual": true,
    "learningAccessEqual": true,
    "explorationAccessEqual": true,
    "challengeAccessEqual": true,
    "taskAssignmentAwarenessEqual": true,
    "resultInterpretationEqual": true,
    "rcaCapabilityEqual": true,
    "inferenceFallbackEqual": true
  },
  "capabilities": [
    "CURRENT_ACTION_LOG_ANALYSIS",
    "EXACT_SHA_PROVENANCE_ANALYSIS",
    "FAILURE_FINGERPRINTING",
    "HISTORICAL_INDEX_SEARCH",
    "ACTION_INDEX_4000_SEARCH",
    "REPAIR_MEMORY_SEARCH",
    "ERROR_TEACHING_5000_SEARCH",
    "ROOT_CAUSE_ANALYSIS",
    "INFERENTIAL_REPAIR",
    "CROSS_CASE_SYNTHESIS",
    "PLAYBOOK_REUSE",
    "ANTI_LESSON_DETECTION",
    "PREDICTIVE_FAILURE_CLASS_ORDERING",
    "TARGETED_REGRESSION_PLANNING",
    "MINIMAL_SOURCE_CHANGE_PLANNING",
    "BOT_TO_BOT_CHALLENGE",
    "TASK_HANDOFF",
    "LESSON_AND_ANTILESSON_LEARNING",
    "FIRST_SEEN_DETECTION",
    "MASTER_ESCALATION",
    "GREEN_CHAIN_INTERPRETATION",
    "EXTERNAL_BLOCK_CLASSIFICATION",
    "CODE_MENTOR_GUIDANCE",
    "TYPE_AND_CONTRACT_REVIEW",
    "CI_CODE_PATTERN_TEACHING"
  ],
  "sharedSources": [
    "diagnostics/auto-repair/action-vault/ACTION-INDEX-4000.json",
    "docs/agents/historical-action-errors/index.json",
    "docs/agents/historical-action-errors/records",
    "diagnostics/auto-repair/memory.json",
    "docs/agents/HISTORICAL-REPAIR-KNOWLEDGE.json",
    "docs/agents/ERROR-TEACHING-ROUTER.json",
    "docs/agents/ERROR-TEACHING-500.md",
    "docs/agents/ERROR-TEACHING-ADDITIONAL-500.md",
    "docs/agents/ERROR-TEACHING-EXPANDED-A-1000.md",
    "docs/agents/ERROR-TEACHING-EXPANDED-B-1000.md",
    "docs/agents/ERROR-TEACHING-EXPANDED-C-1000.md",
    "docs/agents/ERROR-TEACHING-EXPANDED-D-1000.md",
    "docs/agents/INFERENTIAL-REPAIR-INTELLIGENCE.md",
    "docs/agents/ACTION-AGENT-RUNTIME-PROTOCOL.md",
    "docs/agents/historical-action-errors/agent-activity/index.json",
    "docs/agents/historical-action-errors/agent-activity",
    "diagnostics/auto-repair/action-vault/ACTION-CODE-MENTOR.json",
    "scripts/ci/action-code-mentor.mjs"
  ],
  "safetyBoundary": {
    "intelligenceDoesNotImplyMutationAuthority": true,
    "canonicalCiRemainsProofAuthority": true,
    "exactShaRequiredForActionableDecision": true,
    "testMutationForbidden": true,
    "mainMutationForbidden": true,
    "protectedControlPlaneMutationForbidden": true,
    "externalFailureCannotBecomeInternalRepair": true,
    "oneActiveRepairOwnerPerTask": true
  },
  "members": [
    {
      "id": "ACTION-REPAIR",
      "role": "PRIMARY_REPAIR_OWNER",
      "executionAuthority": "MUTATE_WHEN_TASK_OWNER"
    },
    {
      "id": "ACTION-REPAIR-2",
      "role": "SECONDARY_REPAIR_OWNER",
      "executionAuthority": "MUTATE_WHEN_TASK_OWNER_AFTER_HANDOFF"
    },
    {
      "id": "ACTION-HISTORIAN-3",
      "role": "HISTORIAN_AND_SOLUTION_INDEXER",
      "executionAuthority": "RECORD_INDEX_ESCALATE_ONLY"
    }
  ],
  "note": "The three bots have capability parity and mandatory collaboration on each actionable RED. Mutation authority remains role-scoped so cooperation cannot create concurrent source writes.",
  "cooperation": {
    "enabled": true,
    "trigger": "ANY_ACTIONABLE_RED",
    "missionModel": "ONE_SHARED_TASK",
    "identityBinding": [
      "taskId",
      "failureFingerprint",
      "targetSha",
      "failedRunId"
    ],
    "participants": [
      "ACTION-REPAIR",
      "ACTION-REPAIR-2",
      "ACTION-HISTORIAN-3"
    ],
    "requiredWork": [
      "all three read the same exact failure evidence",
      "all three search the same historical/action indexes",
      "all three may form independent RCA and inference hypotheses",
      "all three may challenge competing repair hypotheses",
      "all three exchange findings before mutation",
      "historian records every hypothesis, attempt, handoff and outcome",
      "repair owner selects executable path only after collaboration evidence is assembled",
      "failed owner triggers handoff; other repair bot becomes owner while historian remains attached",
      "canonical GREEN closes the shared mission and promotes only verified learning"
    ],
    "contributionOrder": [
      "ACTION-HISTORIAN-3: intake, first-seen detection, evidence/index record",
      "ACTION-REPAIR-2: independent RCA/inference and counter-hypothesis",
      "ACTION-REPAIR: current-owner RCA/synthesis and bounded repair execution",
      "ACTION-HISTORIAN-3: outcome recording and solution-index update"
    ],
    "authority": {
      "taskOwnership": "single_active_repair_owner",
      "repairOwners": [
        "ACTION-REPAIR",
        "ACTION-REPAIR-2"
      ],
      "historianParticipation": "mandatory_contributor_non_mutating",
      "handoffOnlyAfter": "documented_repair_failure_or_unrepaired",
      "noParallelSourceMutation": true,
      "canonicalGreen": "DAILY_FLIXO_GREEN_GATE"
    },
    "sharedArtifact": "diagnostics/auto-repair/action-vault/current-collaboration.json",
    "hardRule": "ANY_ACTIONABLE_RED_REQUIRES_ALL_THREE_TO_CONTRIBUTE_BEFORE_OWNER_MUTATION",
    "parallelExecution": {
      "cognitiveParallelism": true,
      "sourceMutationParallelism": false,
      "lanes": {
        "ACTION-REPAIR": "PRIMARY_EXECUTION_RCA_AND_BOUNDED_REPAIR",
        "ACTION-REPAIR-2": "INDEPENDENT_RCA_CHALLENGE_AND_FALSIFICATION",
        "ACTION-HISTORIAN-3": "EVIDENCE_INTAKE_INDEX_PROVENANCE_AND_LEARNING"
      },
      "phases": [
        "PARALLEL_DISCOVERY",
        "PARALLEL_ANALYSIS",
        "CROSS_LEARNING",
        "CHALLENGE",
        "SYNTHESIS",
        "OWNER_MUTATION",
        "VERIFICATION",
        "GREEN_LEARNING",
        "CLOSED"
      ],
      "allThreeContributionsRequired": true,
      "exchangeBeforeMutation": true,
      "peerLearningReceiptsRequired": true,
      "oneActiveMutationOwner": true,
      "greenOnlyClosure": true
    },
    "sharedLearning": {
      "provisionalDuringRed": true,
      "promotedOnlyAfterCanonicalGreen": true,
      "evidenceBinding": [
        "taskId",
        "failureFingerprint",
        "targetSha",
        "failedRunId"
      ],
      "crossLearningRequired": true
    },
    "targetedRepair": {
      "protocolRef": "docs/agents/ACTION-VAULT-TARGETED-REPAIR-PROTOCOL.md",
      "planner": "scripts/ci/action-vault-targeted-test.mjs",
      "rule": "REPAIR_AND_RETEST_ONLY_THE_IMPACTED_SURFACE_FIRST",
      "fullSuiteInFastLoop": false,
      "exactShaRequired": true,
      "canonicalGreenRequired": true,
      "runtimePacket": "scripts/ci/action-agent-runtime.mjs"
    },
    "mentorship": {
      "enabled": true,
      "provider": "ACTION-CODE-MENTOR",
      "parentBot": "ACTION-REPAIR",
      "readOnly": true,
      "exactShaRequired": true,
      "invokeBeforeOwnerMutation": true,
      "invokeDuringSelfCheck": true,
      "learners": [
        "ACTION-REPAIR",
        "ACTION-REPAIR-2",
        "ACTION-HISTORIAN-3"
      ],
      "packet": "CODE_MENTOR_PACKET_V1",
      "provisionalDuringRed": true,
      "promotedOnlyAfterCanonicalGreen": true,
      "hardRule": "MENTOR_GUIDANCE_MUST_NEVER_BE_TREATED_AS_PROOF_OR_AUTHORITY"
    }
  },
  "residencyPolicyRef": "diagnostics/auto-repair/action-vault/ACTION-RESIDENCY-POLICY.json",
  "residency": {
    "alwaysResident": true,
    "leaveVault": false,
    "maxOperationsPerBot": 2000000,
    "visitsPerBotPerDay": 3,
    "totalAutomaticVisitsPerDay": 9,
    "closure": "CANONICAL_GREEN_ONLY",
    "escalationAfterFailedAttempts": 20,
    "supervisorRoute": "scripts/ci/agent-communication.mjs -> .github/workflows/agent-communication-relay.yml -> assistantController"
  },
  "agentRuntime": {
    "protocol": "ACTION-AGENT-RUNTIME-v1",
    "runtimeScript": "scripts/ci/action-agent-runtime.mjs",
    "historyScript": "scripts/ci/action-agent-history.mjs",
    "phases": [
      "INTAKE",
      "CONTEXT_RETRIEVAL",
      "PLAN",
      "EXECUTE",
      "SELF_CHECK",
      "INDEPENDENT_REVIEW",
      "VERIFY",
      "LEARN"
    ],
    "exactIdentity": [
      "taskId",
      "failureFingerprint",
      "targetSha",
      "failedRunId"
    ],
    "requirements": {
      "evidenceFirst": true,
      "historicalFirst": true,
      "explicitUnknowns": true,
      "selfCritique": true,
      "independentReview": true,
      "structuredOutput": true,
      "toolBudget": true,
      "noSelfApproval": true
    },
    "efficiency": {
      "parallelCognitiveReads": true,
      "parallelHistoricalRetrieval": true,
      "serializedSourceMutation": true,
      "targetedRegressionFirst": true,
      "fullSuiteInFastLoop": false
    },
    "modelProfiles": {
      "chief": "FRONTIER_REASONING",
      "primary": "FRONTIER_REASONING",
      "adversarial": "FRONTIER_REASONING_ADVERSARIAL"
    }
  }
}
